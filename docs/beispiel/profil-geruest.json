{
  "version": 1,
  "profileName": "demo",
  "mappingStore": "~/.local/share/obfuskation/demo/mapping.json",
  "input": {
    "hasHeaderRecord": true
  },
  "defaults": {
    "unknownField": "error",
    "redactionPlaceholder": "***"
  },
  "fields": [
    {
      "match": "Personennummer",
      "matchType": "exact",
      "action": "error",
      "generator": "numericId",
      "comment": "Vorschlag: pseudonymize mit 'numericId'. Zum Uebernehmen action auf pseudonymize setzen."
    },
    {
      "match": "Nachname",
      "matchType": "exact",
      "action": "error",
      "generator": "lastName",
      "comment": "Vorschlag: pseudonymize mit 'lastName'. Zum Uebernehmen action auf pseudonymize setzen."
    },
    {
      "match": "Vorname",
      "matchType": "exact",
      "action": "error",
      "generator": "firstName",
      "comment": "Vorschlag: pseudonymize mit 'firstName'. Zum Uebernehmen action auf pseudonymize setzen."
    },
    {
      "match": "Straße",
      "matchType": "exact",
      "action": "error",
      "generator": "street",
      "comment": "Vorschlag: pseudonymize mit 'street'. Zum Uebernehmen action auf pseudonymize setzen."
    },
    {
      "match": "PLZ",
      "matchType": "exact",
      "action": "error",
      "generator": "postalCode",
      "comment": "Vorschlag: pseudonymize mit 'postalCode'. Zum Uebernehmen action auf pseudonymize setzen."
    },
    {
      "match": "Ort",
      "matchType": "exact",
      "action": "error",
      "generator": "city",
      "comment": "Vorschlag: pseudonymize mit 'city'. Zum Uebernehmen action auf pseudonymize setzen."
    },
    {
      "match": "EMail",
      "matchType": "exact",
      "action": "error",
      "generator": "email",
      "comment": "Vorschlag: pseudonymize mit 'email'. Zum Uebernehmen action auf pseudonymize setzen."
    },
    {
      "match": "Telefon",
      "matchType": "exact",
      "action": "error",
      "generator": "phone",
      "comment": "Vorschlag: pseudonymize mit 'phone'. Zum Uebernehmen action auf pseudonymize setzen."
    },
    {
      "match": "Geburtsdatum",
      "matchType": "exact",
      "action": "error",
      "generator": "dateShift",
      "comment": "Vorschlag: pseudonymize mit 'dateShift'. Zum Uebernehmen action auf pseudonymize setzen."
    },
    {
      "match": "Notiz",
      "matchType": "exact",
      "action": "error",
      "comment": "Vorschlag: scanText (Freitext). Sicherer waere redact oder drop — Muster finden in Freitext nicht alles. action anpassen."
    }
  ],
  "textRules": [
    {
      "name": "iban",
      "priority": 100,
      "pattern": "\\b[A-Z]{2}\\d{2}(?:[ ]?[A-Z0-9]{4}){2,7}(?:[ ]?[A-Z0-9]{1,4})?\\b",
      "generator": "iban",
      "captureGroup": 0,
      "ignoreCase": false
    },
    {
      "name": "email",
      "priority": 90,
      "pattern": "\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}\\b",
      "generator": "email",
      "captureGroup": 0,
      "ignoreCase": false
    },
    {
      "name": "bic",
      "priority": 85,
      "pattern": "\\b[A-Z]{4}[A-Z]{2}[A-Z0-9]{2}(?:[A-Z0-9]{3})?\\b",
      "generator": "bic",
      "captureGroup": 0,
      "ignoreCase": false
    },
    {
      "name": "phone",
      "priority": 80,
      "pattern": "(?<![\\w\\-/])\\(?(?:\\+49|0)[ \\-/)]?\\d[\\d \\-/()]{5,20}\\d",
      "generator": "phone",
      "captureGroup": 0,
      "ignoreCase": false
    }
  ],
  "generators": {}
}