<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Obfuskation.Gui.ViewModels"
        xmlns:views="using:Obfuskation.Gui.Views"
        mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="680"
        x:Class="Obfuskation.Gui.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="{Binding WindowTitle}"
        Width="980" Height="680" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Icon="avares://obfuskation-gui/Assets/obfuskation.png"
        Background="{DynamicResource BrushBackground}">

  <!--
      Vier Reiter nach Thema statt nach Ablageort (Plan Teil B1): "Textregeln"
      zeigt die gemeinsame Liste aus Projekt- und Erweiterungsregeln,
      "Eigene Generatoren" und "Spalten-Vorschläge" bleiben nach Bereich
      gegliedert (Profil bzw. hauseigen), "Ablageort" beantwortet, wo die
      Erweiterungsdatei liegt und wer sie aendern darf, vorher nur ueber
      'obfuskation extensions path' zu erfahren. Das Fenster arbeitet weiter
      auf Kopien: "Übernehmen" prueft und schreibt zurueck, "Abbrechen"
      verwirft sie.
  -->
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="12">

    <!-- Sperrleiste, nur sichtbar, wenn der globale Bereich gesperrt ist. -->
    <Border Grid.Row="0" Classes="card" Margin="0,0,0,10" BorderBrush="{DynamicResource BrushWarning}"
            IsVisible="{Binding ShowLockBar}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="{Binding LockBarText}" Classes="warning" TextWrapping="Wrap"
                   VerticalAlignment="Center"/>
        <Button Grid.Column="1" Content="Details" Classes="flat" Command="{Binding ShowLocationDetailsCommand}"/>
      </Grid>
    </Border>

    <!-- Ohne Profil (Startseite, "Regeln & Generatoren…") zeigen alle Reiter
         nur noch die Regeln und Generatoren fuer alle Projekte — dieser
         Hinweis sagt das, bevor jemand sich fragt, wo "dieses Projekt" hin ist. -->
    <TextBlock Grid.Row="1" Classes="muted small" Margin="0,0,0,8" TextWrapping="Wrap"
               IsVisible="{Binding !HasProfile}"
               Text="Kein Projekt geöffnet: Hier stehen nur Regeln und Generatoren für alle Projekte."/>

    <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTabIndex}">

      <!-- ================================================== Textregeln ==== -->
      <TabItem Header="Textregeln">
        <views:TextRulesPanel Margin="0,10,0,0" DataContext="{Binding TextRules}"/>
      </TabItem>

      <!-- ============================================ Eigene Generatoren ==== -->
      <TabItem Header="Eigene Generatoren">
        <ScrollViewer Margin="0,10,0,0">
          <StackPanel Spacing="12">
            <!-- Plan P3d: Name und Optionen aendert man jetzt ausschliesslich
                 im Generator-Dialog, die Zeilen selbst sind nur noch Anzeige. -->
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Classes="muted small" TextWrapping="Wrap" VerticalAlignment="Center"
                         Text="Varianten der eingebauten Ersetzungen, etwa ein Token mit Kennzeichnung FW~ – entstehen meist über „Immer ersetzen“ oder hier."/>
              <Button Grid.Column="1" Content="+ Neuer Generator…" Command="{Binding NewGeneratorCommand}"/>
            </Grid>

            <Border Classes="card" IsVisible="{Binding HasProfile}">
              <Grid RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0" Text="Dieses Projekt" Classes="card-title"/>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding ProjectGenerators}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:GeneratorEntryViewModel">
                      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,4">
                        <StackPanel Grid.Column="0">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{Binding DescriptionLabel}" Classes="muted small"/>
                            <TextBlock Text="·" Classes="muted small" IsVisible="{Binding HasOptionsSummary}"/>
                            <TextBlock Text="{Binding OptionsSummary}" Classes="muted small"
                                       IsVisible="{Binding HasOptionsSummary}" TextTrimming="CharacterEllipsis"/>
                          </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Bearbeiten…" Classes="flat"
                                Command="{Binding EditCommand}"/>
                        <Button Grid.Column="2" Content="Entfernen" Classes="flat"
                                Command="{Binding RemoveCommand}"
                                ToolTip.Tip="{Binding RemoveTooltip}"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Grid.Row="1" Classes="muted small" TextWrapping="Wrap"
                           IsVisible="{Binding !HasProjectGenerators}"
                           Text="Noch keine eigenen Generatoren. „+ Neuer Generator…“ legt einen an – etwa ein Token mit Kennzeichnung FW~, damit Pseudonyme erkennbar bleiben."/>
              </Grid>
            </Border>

            <Border Classes="card">
              <Grid RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0" Text="Alle Projekte 🔒" Classes="card-title"
                           IsVisible="{Binding !CanEditGlobal}"/>
                <TextBlock Grid.Row="0" Text="Alle Projekte" Classes="card-title"
                           IsVisible="{Binding CanEditGlobal}"/>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding GlobalGenerators}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:GeneratorEntryViewModel">
                      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,4">
                        <StackPanel Grid.Column="0">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{Binding DescriptionLabel}" Classes="muted small"/>
                            <TextBlock Text="·" Classes="muted small" IsVisible="{Binding HasOptionsSummary}"/>
                            <TextBlock Text="{Binding OptionsSummary}" Classes="muted small"
                                       IsVisible="{Binding HasOptionsSummary}" TextTrimming="CharacterEllipsis"/>
                          </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Bearbeiten…" Classes="flat"
                                Command="{Binding EditCommand}"/>
                        <Button Grid.Column="2" Content="Entfernen" Classes="flat"
                                Command="{Binding RemoveCommand}"
                                ToolTip.Tip="{Binding RemoveTooltip}"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Grid.Row="1" Classes="muted small" TextWrapping="Wrap"
                           IsVisible="{Binding !HasGlobalGenerators}"
                           Text="Noch keine eigenen Generatoren. „+ Neuer Generator…“ legt einen an – etwa ein Token mit Kennzeichnung FW~, damit Pseudonyme erkennbar bleiben."/>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============================================ Spalten-Vorschläge ==== -->
      <TabItem Header="Spalten-Vorschläge">
        <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="0,10,0,0" IsEnabled="{Binding CanEditGlobal}">
          <TextBlock Grid.Row="0" Classes="muted small" TextWrapping="Wrap" Margin="0,0,0,10"
                     Text="Beim Anlegen eines Profils aus einer Datei schlägt das Programm je Spalte eine Ersetzung vor. Maßgeblich ist der Spaltenname, die erste passende Zeile gewinnt."/>

          <!-- Kopf und Zeilen mit denselben festen Spaltenbreiten: Auto-Spalten
               fielen in Kopf (leer bzw. Beschriftung) und Zeile (Pfeile bzw.
               Haekchen) verschieden breit aus, und die Kopfzeile stand
               versetzt. Rechts 14 Punkte fuer die eingeblendete Bildlaufleiste,
               die sonst ueber "Entfernen" laege. -->
          <Grid Grid.Row="1" ColumnDefinitions="52,*,140,100,*,96" ColumnSpacing="8" Margin="0,0,14,4">
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
              <TextBlock Text="Muster für den Spaltennamen" Classes="muted small"/>
              <views:PatternHelpButton IsFieldNameContext="True"/>
            </StackPanel>
            <TextBlock Grid.Column="2" Text="Ersetzen durch" Classes="muted small"/>
            <TextBlock Grid.Column="3" Text="Groß/klein egal" Classes="muted small"/>
            <TextBlock Grid.Column="4" Text="Kommentar" Classes="muted small"/>
          </Grid>

          <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{Binding FieldRules}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FieldNameRuleViewModel">
                  <Grid ColumnDefinitions="52,*,140,100,*,96" ColumnSpacing="8" Margin="0,3,14,3">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2">
                      <Button Content="↑" Classes="flat" Padding="4,0" Command="{Binding MoveUpCommand}"/>
                      <Button Content="↓" Classes="flat" Padding="4,0" Command="{Binding MoveDownCommand}"/>
                    </StackPanel>
                    <TextBox Grid.Column="1" Classes="mono" Text="{Binding Pattern}"
                             IsEnabled="{Binding CanEdit}" PlaceholderText="Muster für den Spaltennamen"
                             ToolTip.Tip="Regulärer Ausdruck – Hilfe und Beispiele unter „?“. Eine KI kann ihn schreiben, bitte keine echten Werte hineingeben."/>
                    <ComboBox Grid.Column="2" HorizontalAlignment="Stretch" ItemsSource="{Binding Generators}"
                              SelectedItem="{Binding Generator}" IsEnabled="{Binding CanEdit}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:GeneratorOption">
                          <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <CheckBox Grid.Column="3" IsChecked="{Binding IgnoreCase}"
                              IsEnabled="{Binding CanEdit}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="4" Text="{Binding Comment}" IsEnabled="{Binding CanEdit}"
                             PlaceholderText="Kommentar"/>
                    <Button Grid.Column="5" Content="Entfernen" Classes="flat" Command="{Binding RemoveCommand}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <Button Grid.Row="3" Content="Hinzufügen" Margin="0,8,0,0" Command="{Binding AddFieldRuleCommand}"/>
        </Grid>
      </TabItem>

      <!-- ==================================================== Ablageort ==== -->
      <TabItem Header="Ablageort">
        <ScrollViewer Margin="0,10,0,0">
          <StackPanel Spacing="12">
            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding GlobalPath}" Classes="mono" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding GlobalReachText}" Classes="muted small" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding GlobalStateText}" Classes="muted" TextWrapping="Wrap"
                           IsVisible="{Binding CanEditGlobal}"/>
                <TextBlock Text="{Binding GlobalStateText}" Classes="warning" TextWrapping="Wrap"
                           IsVisible="{Binding !CanEditGlobal}"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Ordner öffnen" Command="{Binding OpenFolderCommand}"/>
                  <Button Content="Im Editor öffnen" Command="{Binding OpenEditorCommand}"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <Grid RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0" Text="Geprüfte Fundorte" Classes="card-title"/>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Candidates}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ExtensionCandidateInfo">
                      <Grid ColumnDefinitions="*,140,120" Margin="0,3">
                        <TextBlock Grid.Column="0" Text="{Binding Path}" Classes="mono small" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Text="{Binding OriginLabel}" Classes="muted small"/>
                        <TextBlock Grid.Column="2" Text="{Binding StateLabel}" Classes="muted small"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
            </Border>

            <TextBlock Classes="muted small" TextWrapping="Wrap"
                       Text="Für alle Anwender: Datei neben die Programmdatei legen und nur Verwaltern Schreibrecht geben."/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <!-- ====================================================== Fusszeile ==== -->
    <Grid Grid.Row="3" RowDefinitions="Auto,Auto,Auto" Margin="0,12,0,0">
      <TextBlock Grid.Row="0" Classes="warning small" Margin="0,0,0,8" TextWrapping="Wrap"
                 IsVisible="{Binding ShowGlobalCommentsWarning}"
                 Text="Diese Datei enthält von Hand gepflegte Kommentare — vor dem Speichern entsteht eine Sicherungskopie (.bak)."/>

      <Border Grid.Row="1" Classes="card" BorderBrush="{DynamicResource BrushError}" Margin="0,0,0,8"
              IsVisible="{Binding HasValidationErrors}">
        <StackPanel Spacing="4">
          <TextBlock Text="Vor dem Übernehmen zu beheben:" Classes="error" FontWeight="SemiBold"/>
          <ItemsControl ItemsSource="{Binding ValidationErrors}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding}" Classes="error small" TextWrapping="Wrap"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="Abbrechen" Command="{Binding CancelCommand}"/>
        <Button Content="Übernehmen" Classes="primary" Command="{Binding ApplyCommand}"/>
      </StackPanel>
    </Grid>

  </Grid>
</Window>
