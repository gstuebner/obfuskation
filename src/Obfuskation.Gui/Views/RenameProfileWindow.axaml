<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Obfuskation.Gui.ViewModels"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="260"
        x:Class="Obfuskation.Gui.Views.RenameProfileWindow"
        x:DataType="vm:RenameProfileViewModel"
        Title="Profil umbenennen"
        Width="520" MinWidth="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Icon="avares://obfuskation-gui/Assets/obfuskation.png"
        Background="{DynamicResource BrushBackground}">

  <Grid RowDefinitions="Auto,Auto" Margin="16">

    <Border Grid.Row="0" Classes="card">
      <StackPanel Spacing="12">
        <TextBlock Text="{Binding Explanation}" Classes="muted small" TextWrapping="Wrap"/>

        <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
          <TextBlock Grid.Column="0" Text="Neuer Name" Classes="muted" VerticalAlignment="Center"/>
          <TextBox Grid.Column="1" Text="{Binding NewName}"/>
        </Grid>
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="8" Margin="0,12,0,0">
      <Button Content="Abbrechen" Command="{Binding CancelCommand}"/>
      <Button Content="Umbenennen" Classes="primary" Command="{Binding OkCommand}"/>
    </StackPanel>

  </Grid>
</Window>
