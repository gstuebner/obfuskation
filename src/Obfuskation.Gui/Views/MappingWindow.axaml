<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Obfuskation.Gui.ViewModels"
        mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="620"
        x:Class="Obfuskation.Gui.Views.MappingWindow"
        x:DataType="vm:MappingViewModel"
        Title="Ersetzungstabelle"
        Width="760" Height="620" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Icon="avares://obfuskation-gui/Assets/obfuskation.png"
        Background="{DynamicResource BrushBackground}">

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="12">

    <!-- Der Hinweis steht bewusst ganz oben und nicht im Kleingedruckten. -->
    <Border Grid.Row="0" Classes="card" BorderBrush="{DynamicResource BrushWarning}">
      <StackPanel Spacing="4">
        <TextBlock Text="Diese Datei enthält sämtliche Echtdaten" Classes="warning"
                   FontWeight="SemiBold"/>
        <TextBlock Classes="small" TextWrapping="Wrap"
                   Text="Sie ist das schützenswerteste Artefakt des ganzen Vorgangs — niemals in ein Repository, niemals in ein Verzeichnis, aus dem Dateien nach außen gehen, niemals in ein Backup, das das Haus verlässt."/>
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Classes="card" Margin="0,12,0,0">
      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4"
            ColumnSpacing="12">
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Profil" Classes="muted"/>
        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ProfileName}"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Datei" Classes="muted"/>
        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding StorePath}"
                   Classes="mono small" TextWrapping="Wrap"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Rechte" Classes="muted"/>
        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Permissions}" Classes="mono small"/>
      </Grid>
    </Border>

    <Border Grid.Row="2" Classes="card" Margin="0,12,0,0">
      <Grid RowDefinitions="Auto,*">
        <TextBlock Grid.Row="0" Text="Namensräume" Classes="card-title"/>

        <TextBlock Grid.Row="1" Text="{Binding EmptyText}" Classes="muted"
                   VerticalAlignment="Center" IsVisible="{Binding IsEmpty}"
                   TextWrapping="Wrap"/>

        <ScrollViewer Grid.Row="1" MaxHeight="140" IsVisible="{Binding !IsEmpty}">
          <ItemsControl ItemsSource="{Binding Namespaces}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MappingNamespaceViewModel">
                <!-- Der rechte Rand sitzt am Inhalt, nicht als Padding am
                     ScrollViewer: dessen Padding laege innerhalb des
                     Sichtbereichs und wuerde die Bildlaufleiste mitverschieben
                     - die Anzahlen blieben verdeckt. -->
                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,3,14,3" ColumnSpacing="10">
                  <TextBlock Grid.Column="0" Text="{Binding Name}"/>
                  <TextBlock Grid.Column="1" Text="{Binding Count}" Classes="accent"/>
                  <Button Grid.Column="2" Content="Leeren…" Classes="flat" Command="{Binding ClearCommand}"
                          ToolTip.Tip="Alle Einträge dieses Namensraums löschen"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>

    <!-- ===================================================== Werte ==== -->
    <Border Grid.Row="3" Classes="card" Margin="0,12,0,0" IsVisible="{Binding !IsEmpty}">
      <Grid RowDefinitions="Auto,Auto,*">

        <StackPanel Grid.Row="0" Spacing="4" IsVisible="{Binding !ValuesVisible}">
          <TextBlock Classes="warning small" TextWrapping="Wrap"
                     Text="Die Tabelle enthält alle Echtdaten. Nur einblenden, wenn niemand mitliest."/>
          <Button Content="Werte anzeigen" Command="{Binding ToggleValuesCommand}"/>
        </StackPanel>

        <StackPanel Grid.Row="0" IsVisible="{Binding ValuesVisible}">
          <Button Content="Werte ausblenden" Classes="flat" Command="{Binding ToggleValuesCommand}"
                  HorizontalAlignment="Left"/>

          <Grid ColumnDefinitions="*,220" ColumnSpacing="8" Margin="0,8,0,0">
            <TextBox Grid.Column="0" Text="{Binding SearchText}"
                     PlaceholderText="Klartext oder Pseudonym suchen …"/>
            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                      ItemsSource="{Binding NamespaceFilterOptions}"
                      SelectedItem="{Binding SelectedNamespaceFilter}"/>
          </Grid>

          <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Classes="muted small"
                       Text="{Binding SelectedCount, StringFormat='{}{0} ausgewählt'}"/>
            <Button Grid.Column="1" Content="Ausgewählte löschen…" Command="{Binding RemoveSelectedCommand}"/>
          </Grid>
        </StackPanel>

        <!-- Kopfzeile der Tabelle, nur sichtbar, wenn auch Zeilen folgen. -->
        <Grid Grid.Row="1" ColumnDefinitions="160,*,30,*" Margin="0,10,8,2"
              IsVisible="{Binding ValuesVisible}">
          <TextBlock Grid.Column="0" Text="Namensraum" Classes="muted small" FontWeight="SemiBold"/>
          <TextBlock Grid.Column="1" Text="Klartext" Classes="muted small" FontWeight="SemiBold"/>
          <TextBlock Grid.Column="3" Text="Pseudonym" Classes="muted small" FontWeight="SemiBold"/>
        </Grid>

        <!-- Virtualisiert ueber VirtualizingStackPanel (die Vorgabe von
             ListBox.ItemsPanel): die Tabelle kann zehntausende Eintraege
             haben, ein ItemsControl ohne Virtualisierung baute sie alle auf
             einmal auf. -->
        <ListBox Grid.Row="2" Name="EntriesList" ItemsSource="{Binding Entries}"
                  SelectionMode="Multiple" IsVisible="{Binding ValuesVisible}"
                  SelectionChanged="OnEntrySelectionChanged">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:MappingEntryViewModel">
              <Grid ColumnDefinitions="160,*,30,*" Margin="0,1">
                <TextBlock Grid.Column="0" Text="{Binding Namespace}" Classes="small muted"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="{Binding Plaintext}" Classes="small mono"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2" Text="→" Classes="accent small"/>
                <TextBlock Grid.Column="3" Text="{Binding Pseudonym}" Classes="small mono accent"
                           TextTrimming="CharacterEllipsis"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
      <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
        <TextBlock Text="{Binding TotalText}" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding StatusMessage}" Classes="warning small" TextWrapping="Wrap"
                   IsVisible="{Binding HasStatusMessage}"/>
      </StackPanel>
      <Button Grid.Column="1" Content="Schließen" Classes="primary" Click="OnClose"/>
    </Grid>

  </Grid>
</Window>
