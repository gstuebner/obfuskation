<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Obfuskation.Gui.ViewModels"
        xmlns:views="using:Obfuskation.Gui.Views"
        mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="720"
        x:Class="Obfuskation.Gui.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding ProfileTitle}"
        Width="1040" Height="720"
        MinWidth="760" MinHeight="520"
        Icon="avares://obfuskation-gui/Assets/obfuskation.png"
        Background="{DynamicResource BrushBackground}">

  <!--
      Der Rahmen um drei austauschbare Ansichten (Start, Text, Dateien) —
      siehe MainViewModel.CurrentView. Die Kopfzeile bleibt in jeder Ansicht
      sichtbar und traegt links immer denselben Weg zurueck zur Startseite;
      rechts zeigt sie nur die Schaltflaechen, die in der jeweiligen Ansicht
      auch etwas bedeuten — "Neu aus Datei…" und "Speichern" beziehen sich
      auf eine Datei, die es ausserhalb der Dateiansicht nicht gibt.
  -->
  <Grid RowDefinitions="Auto,*" Margin="12">

    <!-- ============================================== Kopfzeile ======== -->
    <Grid Grid.Row="0" RowDefinitions="Auto,Auto" Margin="0,0,0,12">

      <Grid Grid.Row="0" ColumnDefinitions="*,Auto">

        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6"
                    VerticalAlignment="Center">
          <!-- Als Schaltflaeche statt TextBlock: von jeder Ansicht aus mit
               einem Klick zurueck zur Startseite. Das geladene Profil bleibt
               dabei im Hintergrund bestehen — es wird nur die Ansicht
               gewechselt, nichts verworfen. -->
          <Button Classes="flat" Padding="0" Command="{Binding ShowStartCommand}"
                  ToolTip.Tip="Zur Startseite">
            <TextBlock Text="Obfuskation" Classes="heading"/>
          </Button>
          <TextBlock Text="{Binding ProfileName}" Classes="muted"
                     VerticalAlignment="Center" Margin="4,0,0,0"/>

          <!-- Erklaert, wofuer ein Profil da ist: dort, wo der Begriff
               zum ersten Mal auftaucht. -->
          <Button Classes="flat" Padding="2" VerticalAlignment="Center"
                  IsVisible="{Binding HasProfile}" ToolTip.Tip="Was ist ein Profil?">
            <TextBlock Text="ⓘ" FontSize="13"/>
            <Button.Flyout>
              <Flyout>
                <TextBlock MaxWidth="360" TextWrapping="Wrap" Classes="small"
                           Text="Ein Profil bündelt die Feldregeln und die Ersetzungstabelle. Alle zusammengehörenden Dateien unter demselben Profil bearbeiten — nur dann bekommt derselbe Klartext in allen Dateien dasselbe Pseudonym. Die Reihenfolge, in der die Dateien geöffnet werden, spielt keine Rolle."/>
              </Flyout>
            </Button.Flyout>
          </Button>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
          <!-- Nur im Dateimodus sinnvoll: beide beziehen sich auf eine
               geoeffnete Datendatei bzw. das Sichern ihres Regelwerks. Im
               Start- und Textmodus blieben sie wirkungslose Umwege. -->
          <Button Content="Neu aus Datei…" Command="{Binding NewProfileCommand}"
                  IsVisible="{Binding IsFilesView}"
                  ToolTip.Tip="Regelgeruest aus einer vorhandenen Datei ableiten"/>
          <Button Content="Profile…" Command="{Binding ShowProfilesCommand}"/>
          <Button Content="Speichern" Command="{Binding SaveProfileCommand}"
                  IsVisible="{Binding IsFilesView}"/>

          <Button Content="Mehr ▾">
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="Ersetzungstabelle…" Command="{Binding ShowMappingCommand}"/>
                <!-- Der fruehere Eintrag "Textregeln…" entfaellt: eigene Muster
                     legt "Immer ersetzen…" an (Textansicht und Dateiansicht),
                     die Fachansicht bleibt darueber unter "Muster von Hand
                     bearbeiten…" erreichbar. -->
                <MenuItem Header="Hauseigene Muster…" Command="{Binding ShowExtensionsCommand}"/>
                <Separator/>
                <MenuItem Header="Kurzhilfe…" Command="{Binding ShowHelpCommand}"/>
                <MenuItem Header="Über Obfuskation…" Command="{Binding ShowAboutCommand}"/>
              </MenuFlyout>
            </Button.Flyout>
          </Button>

          <Button Classes="flat" Command="{Binding ToggleThemeCommand}"
                  ToolTip.Tip="Ansicht umschalten: System, Dunkel, Hell">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{Binding ThemeSymbol}" FontSize="15"/>
              <TextBlock Text="{Binding ThemeName}" Classes="small" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <!-- Padding statt Margin: Padding zaehlt in die Messung des TextBlocks
           hinein und schafft unten verlaesslich Platz fuer Unterlaengen (p, g,
           j) bei kleiner Schrift - Margin wirkt nur aussen und die Karte
           darunter uebermalt sie sonst. TextWrapping bleibt weg, weil
           CharacterEllipsis den Umbruch schon unterbindet; beides zusammen
           war es, was den knappen Trimming-Pfad ausgeloest hat. -->
      <TextBlock Grid.Row="1" Text="{Binding ProfileSubtitle}" Classes="muted small"
                 IsVisible="{Binding HasProfileSubtitle}" Padding="0,3,0,3"
                 TextTrimming="CharacterEllipsis"/>
    </Grid>

    <!-- ================================================= Inhalt ======== -->
    <!-- Genau eine der drei Ansichten ist sichtbar. Alle drei binden auf ein
         Ansichtsmodell, das vom Hauptansichtsmodell kommt (Dateiansicht
         direkt darauf, unveraendert wie vor dem Umbau; Start- und Textansicht
         ueber eigens dafuer erzeugte Instanzen). -->
    <Grid Grid.Row="1">
      <!-- IsVisible steht jeweils auf einem eigenen Panel statt direkt auf
           der Ansicht: DataContext auf demselben Element umgeschaltet haette
           auch IsVisible gegen das falsche Ansichtsmodell aufgeloest — die
           Bindungskontexte eines Elements haengen alle an seinem eigenen
           DataContext, nicht nur die der Kinder. -->
      <Panel IsVisible="{Binding IsStartView}">
        <views:StartView DataContext="{Binding Start}"/>
      </Panel>
      <views:FilesView IsVisible="{Binding IsFilesView}"/>
      <Panel IsVisible="{Binding IsTextView}">
        <views:TextView DataContext="{Binding Text}"/>
      </Panel>
    </Grid>

  </Grid>
</Window>
