<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Obfuskation.Gui.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="640"
             x:Class="Obfuskation.Gui.Views.TextView"
             x:DataType="vm:TextViewModel">

  <!--
      Kein Feld, kein Generator, keine Regex ist hier sichtbar — die Regeln
      kommen aus dem Profil im Hintergrund (siehe MainViewModel.EnsureTextProfile).
      Zwischenablage, Dateiauswahl und Drag&Drop leben ausschliesslich hier im
      Codebehind: das Ansichtsmodell kennt nur InputText als schlichten Wert
      und bleibt damit ohne laufende Avalonia-Umgebung pruefbar.
  -->
  <Grid RowDefinitions="Auto,*,Auto">
    <Grid.Styles>
      <Style Selector="Border.card">
        <Setter Property="Margin" Value="0,0,0,12"/>
      </Style>
    </Grid.Styles>

    <!-- ==================================== Richtungsumschalter ========= -->
    <Border Grid.Row="0" Classes="card">
      <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="16">
          <TextBlock Text="Richtung" Classes="muted" VerticalAlignment="Center"/>
          <RadioButton GroupName="textRichtung" Content="Text säubern"
                       IsChecked="{Binding IsForward}"/>
          <RadioButton GroupName="textRichtung" Content="Antwort zurückübersetzen"
                       IsChecked="{Binding IsReverse}"/>
        </StackPanel>

        <!-- Steht die Verlaesslichkeit des Gezeigten in Frage, gehoert das
             nach oben und nicht in die Fundzeile: von hier aus wandert der
             Text in eine fremde Hand. -->
        <TextBlock Text="{Binding StoreWarning}" Classes="warning small"
                   IsVisible="{Binding HasStoreWarning}" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <!-- ========================================== Text | Ergebnis ======= -->
    <Grid Grid.Row="1" ColumnDefinitions="*,12,*" RowDefinitions="*,Auto">

      <!-- AllowDrop sitzt an der Karte, nicht am Eingabefeld: gezogen werden
           darf in beiden Zustaenden, auch in der Prueffassung. -->
      <Border Grid.Column="0" Classes="card" Margin="0" DragDrop.AllowDrop="True">
        <Grid RowDefinitions="Auto,*">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto">
            <TextBlock Grid.Column="0" Text="Text" Classes="card-title" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="{Binding EditToggleLabel}" Classes="flat"
                    Click="OnToggleEditing"
                    ToolTip.Tip="Zwischen Bearbeiten und der farbigen Prüffassung wechseln"/>
            <Button Grid.Column="2" Content="Einfügen" Classes="flat" Click="OnPaste"
                    ToolTip.Tip="Text aus der Zwischenablage einfügen"/>
            <Button Grid.Column="3" Content="Datei…" Classes="flat" Click="OnOpenFile"
                    ToolTip.Tip="Textdatei öffnen"/>
          </Grid>

          <!-- Zwei Zustaende an derselben Stelle. Ein Eingabefeld kann in
               Avalonia keine Hintergruende je Textabschnitt tragen, ein
               SelectableTextBlock kein Tippen — beides zugleich gibt es nicht.
               Die Prueffassung ist der Regelfall (Text kommt fast immer ueber
               Einfügen oder Datei herein), das Feld der Ausnahmefall. -->
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                        IsVisible="{Binding !IsEditing}">
            <SelectableTextBlock x:Name="InputBlock" TextWrapping="Wrap"
                                 ContextRequested="OnInputContextRequested">
              <SelectableTextBlock.ContextFlyout>
                <!-- Ein eigenes Menue verdraengt das eingebaute. Hier ist das
                     unbedenklich: die Prueffassung ist schreibgeschuetzt, es
                     faellt also nur Ausschneiden und Einfügen weg, was auf ihr
                     ohnehin nichts zu suchen haette. Dasselbe Menue mit den
                     nachgebauten Standardeintraegen traegt auch das
                     Eingabefeld, damit "immer ersetzen…" in beiden Zustaenden
                     am selben Ort liegt. -->
                <MenuFlyout>
                  <MenuItem Header="Kopieren" InputGesture="Ctrl+C" Click="OnCopySelection"/>
                  <MenuItem Header="Alles auswählen" InputGesture="Ctrl+A" Click="OnSelectAll"/>
                  <Separator/>
                  <MenuItem x:Name="AlwaysReplaceItem" Click="OnAlwaysReplaceSelection"/>
                </MenuFlyout>
              </SelectableTextBlock.ContextFlyout>
            </SelectableTextBlock>
          </ScrollViewer>

          <TextBox Grid.Row="1" x:Name="InputBox" Text="{Binding InputText}"
                   IsVisible="{Binding IsEditing}"
                   AcceptsReturn="True" TextWrapping="Wrap"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   ContextRequested="OnEditContextRequested"
                   PlaceholderText="Text einfügen, tippen oder eine Datei hierher ziehen …">
            <!-- Eigenes Menue verdraengt das eingebaute; hier ist das der
                 Preis fuer "immer ersetzen…" an genau der Stelle, an der ein
                 Anfaenger markiert. Die vier Standardeintraege rufen dieselben
                 TextBox-Methoden wie das native Menue (Cut/Copy/Paste/SelectAll),
                 es geht also nichts verloren. -->
            <TextBox.ContextFlyout>
              <MenuFlyout>
                <MenuItem Header="Ausschneiden" InputGesture="Ctrl+X" Click="OnEditCut"/>
                <MenuItem Header="Kopieren" InputGesture="Ctrl+C" Click="OnEditCopy"/>
                <MenuItem Header="Einfügen" InputGesture="Ctrl+V" Click="OnEditPaste"/>
                <MenuItem Header="Alles auswählen" InputGesture="Ctrl+A" Click="OnEditSelectAll"/>
                <Separator/>
                <MenuItem x:Name="AlwaysReplaceEditItem" Click="OnAlwaysReplaceSelection"/>
              </MenuFlyout>
            </TextBox.ContextFlyout>
          </TextBox>
        </Grid>
      </Border>

      <!-- Der Hinweis gehoert zur linken Seite und nicht in die Fundliste:
           genau dort markiert ja, wer etwas nachreichen will. Dass die
           eingebauten Kategorien nicht alles sehen, ist zudem das, was ein
           Einsteiger nicht von selbst annimmt, darum steht es dauerhaft da. -->
      <TextBlock Grid.Row="1" Grid.Column="0" Classes="muted small" Margin="2,6,0,0"
                 IsVisible="{Binding IsForward}" TextWrapping="Wrap"
                 Text="Noch etwas Vertrauliches ohne Farbe? Links markieren, rechte Maustaste → „… immer ersetzen…“ (oder Strg+M) — der Dialog fragt in Klartext, kein regulärer Ausdruck nötig."/>

      <Border Grid.Column="2" Classes="card" Margin="0">
        <Grid RowDefinitions="Auto,*">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto">
            <TextBlock Grid.Column="0" Text="Ergebnis" Classes="card-title" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Kopieren" Classes="primary" Click="OnCopyResult"
                    ToolTip.Tip="Echten Lauf auslösen und das Ergebnis in die Zwischenablage legen"/>
            <Button Grid.Column="2" Content="Speichern…" Classes="flat" Click="OnSaveResult"/>
          </Grid>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <SelectableTextBlock x:Name="ResultBlock" Classes="mono" TextWrapping="Wrap"/>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <!-- ==================================================== Funde ======= -->
    <!-- Nur in Vorwaertsrichtung: die Rueckuebersetzung laeuft ueber die
         Ersetzungstabelle, nicht ueber Textregeln, und kennt darum keine
         einzeln abwaehlbaren Fundstellen (siehe TextViewModel.RefreshReverse). -->
    <Border Grid.Row="2" Classes="card" Margin="0,0,0,0" IsVisible="{Binding IsForward}">
      <StackPanel Spacing="6">

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <TextBlock Grid.Column="0" Text="{Binding MatchSummary}" Classes="muted small"
                     VerticalAlignment="Center" TextWrapping="Wrap"/>

          <!-- Die Legende erklaert die Ansicht ohne einen Satz Hilfetext: was
               farbig ist, ist versorgt; was farblos bleibt, ginge im Klartext
               hinaus. Das ist die eigentliche Aussage der ganzen Seite. -->
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                      VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Border Width="10" Height="10" CornerRadius="2" VerticalAlignment="Center"
                      Background="#8C3EA25B" BorderThickness="1"
                      BorderBrush="{DynamicResource BrushBorder}"/>
              <TextBlock Text="ersetzt" Classes="muted small"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Border Width="10" Height="10" CornerRadius="2" VerticalAlignment="Center"
                      Background="#8CD97706" BorderThickness="1"
                      BorderBrush="{DynamicResource BrushBorder}"/>
              <TextBlock Text="bewusst behalten" Classes="muted small"/>
            </StackPanel>
            <TextBlock Text="ohne Farbe = nicht erkannt" Classes="muted small"/>
          </StackPanel>
        </Grid>

        <ScrollViewer MaxHeight="160" IsVisible="{Binding HasMatches}">
          <ItemsControl ItemsSource="{Binding Matches}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TextMatchViewModel">
                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto" ColumnSpacing="8" Margin="0,2">
                  <CheckBox Grid.Column="0" IsChecked="{Binding IsIncluded}"
                            IsEnabled="{Binding CanToggle}"
                            ToolTip.Tip="Diesen Fund für diesen Durchgang abschalten"/>
                  <TextBlock Grid.Column="1" Text="{Binding Original}" Classes="mono small"
                             TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="2" Text="→" Classes="accent small"/>
                  <TextBlock Grid.Column="3" Text="{Binding Replacement}" Classes="mono small accent"
                             TextTrimming="CharacterEllipsis"/>
                  <!-- Zwei Knoepfe an derselben Stelle, je nach Herkunft der
                       Regel. Bei einer selbst angelegten waere "immer…"
                       gegenstandslos (sie gilt bereits immer); gebraucht wird
                       dort der Rueckweg, den es sonst nur im Regex-Editor gibt
                       — also genau dort, wovor der schlichte Dialog bewahren
                       soll. Die vier eingebauten Regeln bleiben unantastbar:
                       fuer sie ist das Haekchen der richtige Weg, denn es gilt
                       nur fuer diesen einen Durchgang. -->
                  <Button Grid.Column="4" Content="immer…" Classes="flat"
                          IsVisible="{Binding !IsUserRule}"
                          Command="{Binding AlwaysReplaceCommand}"
                          ToolTip.Tip="Aus diesem Fund eine dauerhafte Ersetzungsregel anlegen"/>
                  <Button Grid.Column="4" Content="Regel entfernen" Classes="flat"
                          IsVisible="{Binding IsUserRule}"
                          Command="{Binding RemoveRuleCommand}"
                          ToolTip.Tip="Die selbst angelegte Regel wieder löschen"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Classes="card" Margin="0" IsVisible="{Binding IsReverse}">
      <TextBlock Text="{Binding MatchSummary}" Classes="muted"/>
    </Border>

  </Grid>
</UserControl>
