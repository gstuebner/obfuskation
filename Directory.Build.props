<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- Eine Fassung fuer alle Projekte. Vorher stand sie nur in der
         Oberflaeche, das Kommandozeilenprogramm lief auf der Vorgabe 1.0.0
         mit — zwei Programme desselben Pakets duerfen nicht auseinanderlaufen.
         1.0.1: Behebung der Befunde D-4 und D-8 der Testdurchfuehrung vom
         4. September 2026, siehe docs/testdokumentation.md.
         1.0.2: Fassung und Ersteller stehen jetzt unter jeder Hilfeausgabe
         des Kommandozeilenprogramms.
         1.1.0: Profilverwaltung: fester Ablageort, Anlegen-Dialog mit Namen
         und Beschreibung, Profiluebersicht, Umbenennen ohne Verlust der
         Ersetzungstabelle, Rueckfrage bei ungespeicherten Aenderungen; auf der
         Kommandozeile 'obfuskation profile list' und die Option config, jetzt
         auch mit blossem Profilnamen statt Dateipfad. Dazu eine Kurzhilfe im
         Menue "Mehr" und neue Beschriftungen der beiden Schaltflaechen unten:
         "Pseudodatei erzeugen..." und "Klartextdatei erzeugen...". Nebenversion
         statt Korrekturstand, weil Funktionen dazugekommen sind.
         1.2.0: Mehrfachauswahl in der Feldliste — Aktion und Generator gelten
         fuer alle gewaehlten Felder auf einmal. Dazu behoben: als Einzeldatei
         veroeffentlicht brach die Oberflaeche bei jedem Schreiben einer
         Konfiguration stumm ab, weil die mitgepackte System.IO.Pipelines 8.0.0
         die der Laufzeit verdeckte; siehe Kommentar in
         src/Obfuskation.Gui/Obfuskation.Gui.csproj.
         1.3.0: Schnellwahl "Zuletzt ▾" zwischen den Dateien eines Profils ohne
         Oeffnen-Dialog; Feldvorschau steht jetzt ueber der Aktionswahl, zeigt
         bis zu drei Beispielwerte und erscheint auch ohne moegliche Vorschau,
         mit CsvHelper statt Eigenbau und richtigem Zeichensatz (auch JSON);
         konfigurierbares Praefix je Token-Namensraum
         (GeneratorSettings.Prefix), von 'init' vorgeschlagen und ueber die
         Regelkarte setzbar. Dazu behoben: N-1 (Untertitel abgeschnitten),
         D-5 (Bildlaufleiste ueber den Anzahlen), D-6 (Hinweistext
         abgeschnitten), D-1 (doppelte Befundliste), D-3 (Hinweise bei
         fehlerhafter Konfiguration jetzt sichtbar) und D-9 (Speichern in der
         Einzeldatei-Veroeffentlichung); D-2 bekommt zusaetzlich eine Warnung
         im Bericht ("datumMitFremdemProfil"); D-7 teilweise behoben: Text der
         Hilfeoption jetzt deutsch, die Ueberschrift "Description:" bleibt aus
         den in Abschnitt 11 der Entwicklerdokumentation genannten Gruenden
         eine bekannte Einschraenkung des Pakets System.CommandLine 2.0.11.
         1.4.0: Profiluebersicht: "Aus Liste entfernen" blendet den Eintrag
         jetzt dauerhaft aus (GuiSettings.HiddenProfiles), statt dass er beim
         naechsten Aufbau der Liste ohne Nutzungsdaten zurueckkommt, weil
         ProfileCatalog.Collect den zentralen Profilordner ohnehin immer
         vollstaendig auflistet. Dazu neu "Profil
         loeschen..." mit Rueckfrage, ob die Ersetzungstabelle mitgeloescht
         wird. "Neu aus Datei..." erlaubt jetzt Mehrfachauswahl: ein Profil
         entsteht aus den Feldern aller gewaehlten Dateien auf einmal
         (ProfileScaffolder.Create mit mehreren Pfaden). Neu die Sammellaeufe
         "Alle Pseudodateien erzeugen..." und "Alle Klartextdateien
         erzeugen...", mit genau einer Rueckfrage statt einer je Datei;
         geschrieben wird jeweils neben die Eingabedatei.
         1.5.0: Fuenf neue Generatoren. Fuer Datumswerte war 'dateShift'
         bisher der einzige Weg; sein profilweit konstanter Offset erhaelt
         Reihenfolge und Abstaende und ist genau deshalb angreifbar, sobald
         ein einziges Datum des Bestands bekannt ist. Neu daneben
         'dateRange' (zieht ein Datum, umkehrbar ueber die Ersetzungstabelle;
         ohne 'from'/'to' bleibt das Kalenderjahr des Originals) und
         'dateGeneralize' (rundet auf Monat, Quartal oder Jahr, ausdruecklich
         nicht umkehrbar). 'dateShift' bleibt die Vorgabe als einziger
         Generator, der Reihenfolge und Abstaende erhaelt. Ausserdem
         'pattern' (Wert nach Maske, ohne Maske formaterhaltend aus dem
         Original abgeleitet), 'wordlist' (eigene Werteliste im Profil)
         und 'partialMask' (haelt einen Teil des Wertes sichtbar): drei
         Faelle, die bisher alle beim generischen 'token' landeten.
         Dazu 'defaults.emptyValues', damit faktisch leere Werte ("-",
         "N/A", reiner Leerraum) nicht laenger ein Pseudonym bekommen;
         'redact' liest seinen Platzhalter aus einem eigenen Feld statt aus
         'domain', womit ein eigener Namensraum seinen Platzhalter behalten
         kann; die MappingConflictException nennt die zum Generator passende
         Abhilfe statt pauschal 'token'; 'deobfuscate' meldet Werte nicht
         umkehrbarer Generatoren als "nichtWiederherstellbar" statt als
         unbekanntes Pseudonym. In der Oberflaeche ein eigener Dialog fuer
         die neuen Optionen, der seine Zuordnung aus
         ProfileValidator.OptionOwnership liest.
         1.6.0: Erweiterungsdatei. Hauseigene Muster, etwa eine Inventarnummer der
         Form INV123456, sind Betriebswissen und haben in einer Profildatei
         nichts verloren, die geteilt oder eingecheckt wird. Sie liegen
         deshalb in einer eigenen, privaten Datei namens obfuskation.json,
         gesucht zuerst neben der Programmdatei, sonst unter
         ~/.config/obfuskation (Klasse ExtensionLibrary, vormals
         GeneratorLibrary), und fliessen zur Laufzeit in jedes Profil ein,
         ohne je hineingeschrieben zu werden; bei gleichem Namen gewinnt
         immer das Profil. Neu dazu der Befehl 'extensions list' bzw. 'path'
         (vormals 'library') und die Option 'no extensions' (vormals
         'no library'), die einen Lauf ohne die Erweiterungsdatei erzwingt.
         Zweitens die wertbasierte Mustererkennung (ValueSuggester): zaehlt
         zuerst, ob die Beispielwerte vollstaendig auf ein bekanntes Muster
         passen, eingebautes oder eigenes aus der Erweiterungsdatei. In der
         Oberflaeche als Knopf "Muster erkennen...", auf der Kommandozeile in
         den Kommentaren von 'init'. Drittens neu der Abschnitt fieldRules in
         der Erweiterungsdatei (Klasse FieldNameSuggester): Regeln auf den
         ganzen Spaltennamen, erste passende Regel gewinnt, Sonderwert
         scanText fuer Freitextfelder. Das bis einschliesslich 1.5.0 fest
         einkompilierte Raten an dreissig Namensfragmenten
         (ProfileScaffolder.Hints) ist dabei ersatzlos entfallen: ohne
         Erweiterungsdatei raet das Programm nicht mehr am Spaltennamen.
         Ersatz ist docs/beispiel/obfuskation-erweiterung-beispiel.json, das
         die alte Liste als fieldRules enthaelt. Vorschlagsreihenfolge damit:
         Wertetreffer, dann Spaltennamenregel aus der Erweiterungsdatei,
         sonst eigener token-Namensraum. Viertens die Profildatei umbenannt
         auf obfuskation-projekt.json (ProfileStore.DefaultFileName); eine
         vorhandene obfuskation.json mit Profilinhalt bleibt lesbar
         (LegacyFileName, LooksLikeProfile unterscheidet die beiden Rollen
         am Inhalt). Fuenftens der Nachzug der Dokumentation: die fuenf
         Generatoren aus 1.5.0 standen in keiner Doku, und die
         Entwicklerdokumentation behauptete noch, 'redact' zweckentfremde
         'domain' als Platzhalter.
         1.7.0: Drei Zugaenge statt einem leeren Startfenster. Neu die
         Startseite (drei Karten: Text saeubern, Dateien pseudonymisieren,
         Antwort zurueckholen) und die Textansicht; Zwischenablage
         einfuegen, Fundstellen mit Haekchen einzeln abwaehlbar, "Kopieren"
         legt erst dann Eintraege in der Ersetzungstabelle an. Ohne
         geladenes Profil legt die Textansicht ein Vorgabeprofil 'text' an;
         MappingStore.EnsureCreated (neu, ObfuscationEngine.EnsureMappingStore
         als duenne Huelle darum) sorgt dafuer, dass ein Probelauf exakt
         dieselben Werte liefert wie der echte. Zweitens "Immer ersetzen…":
         aus einem markierten Begriff (Textansicht) oder einem Feld-
         Beispielwert (Dateiansicht, Knopf neben "Felder automatisch
         erkennen…", vormals "Muster erkennen…") in drei Fragen ohne
         regulaeren Ausdruck eine Regel ableiten; PatternFromSample (neu)
         bildet aus 'FW123456' wahlweise "genau dieses Wort" oder "FW + 6
         Ziffern"; gilt sie "immer, in allen Projekten", landet sie ueber
         ExtensionLibrary.Save (neu, mit Sicherungskopie bei einer von Hand
         kommentierten Datei) in der Erweiterungsdatei statt im Profil. Der
         Menueintrag "Textregeln…" entfaellt, die Fachansicht bleibt aus
         diesem Dialog ueber "Muster von Hand bearbeiten…" erreichbar; neu
         dafuer "Hauseigene Muster…", das Fundort und geerbte Regeln der
         Erweiterungsdatei zeigt, bisher nur ueber 'obfuskation extensions
         path' zu erfahren. Drittens zwei kleine Korrekturen: eine geoeffnete
         Fliesstextdatei zeigte in der Feldliste faelschlich "Keine Datei
         geöffnet" statt eines Hinweises auf "Immer ersetzen…" samt Knopf "In
         der Textansicht öffnen"; die Kurzhilfe nennt jetzt auch den
         Textmodus.
         1.7.1: Die Startseite aus 1.7.0 bekam kaum jemand zu sehen. Sie
         erschien nur, wenn weder ein Profil uebergeben noch eines gefunden
         noch eines zuletzt benutzt worden war — wer schon einmal mit einem
         Profil gearbeitet hat, hat aber ab dann immer einen Eintrag in
         GuiSettings.RecentProfiles und landete darum wie vor 1.7.0 sofort in
         der Dateiansicht. Betroffen war damit genau jeder Bestandsanwender,
         also jeder, dem Textansicht und "Immer ersetzen…" neu sind. Die
         Startseite ist jetzt der Einstieg; uebersprungen wird sie allein bei
         einem Profil oder einer Datei auf der Befehlszeile, wo jemand
         ausdruecklich gesagt hat, was er will. Ein zuletzt benutztes Profil
         wird weiterhin geladen und steht dort als erste Karte "Weiter mit …"
         bereit, die nur die Ansicht wechselt (kein zweites Laden, eine
         geoeffnete Datei bleibt offen). Dazu ein sichtbarer Rueckweg
         "← Start" in der Kopfzeile: der anklickbare Programmname tat das
         schon, wurde aber als Ueberschrift gelesen, nicht als
         Schaltflaeche. -->
    <!-- 1.7.2: Farbe in der Textansicht. Der eingefuegte Text steht links in
         einer Prueffassung, in der erkannte Stellen hinterlegt sind: gruen,
         was ersetzt wird, orange, was ein geleertes Haekchen im Klartext
         behaelt; rechts dieselben Stellen am Ersatzwert. Ohne Farbe heisst
         "von keiner Regel erfasst": die Aussage, die der Ansicht bisher
         fehlte, und der Grund, warum ein Knopf "nicht erkannte Daten"
         unverstaendlich blieb. Uebersehenes wird jetzt markiert und ueber das
         Kontextmenue weitergereicht, dessen Eintrag den markierten Wert nennt.
         Dazu ein globales Sicherheitsnetz: unbehandelte Ausnahmen aus
         Dispatcher, Task und AppDomain landen in absturz.log neben gui.json,
         und die Anwendung laeuft weiter, statt einen ungespeicherten Text
         mitzunehmen. -->
    <!-- 1.8.0: Einstellungen an einem Ort statt ueber Umwege. Neu das Fenster
         "Einstellungen" (Knopf in der Kopfzeile, Strg+,) mit zwei Reitern:
         das geladene Projekt und die hauseigene Erweiterungsdatei
         nebeneinander, beide mit Textregeln, eigenen Generatoren und (global)
         Spaltenmustern; eine Regel laesst sich zwischen beiden verschieben,
         ihr eigener Generator wandert mit. Ersetzt "Muster von Hand
         bearbeiten…", "Hauseigene Muster…" (nur lesend) und das eigene
         Fenster "Textregeln". Das Fenster arbeitet auf Kopien: "Übernehmen"
         prueft zuerst mit ProfileValidator, "Abbrechen" verwirft alles.
         Zweitens die Ersetzungstabelle bearbeitbar: Werte bleiben verdeckt,
         bis man sie ausdruecklich einblendet (immer aus beim Oeffnen), dann
         Suche ueber Klartext und Pseudonym, Mehrfachauswahl und "Leeren…" je
         Namensraum (MappingStore.Remove, RemoveNamespace, neu). Drittens drei
         behobene Fehler: eine kaputte Erweiterungsdatei wurde beim naechsten
         "immer, in allen Projekten" stillschweigend mit nur der neuen Regel
         ueberschrieben (jetzt ExtensionLibrary.GetWriteState statt
         ResolveWritePath, das nie mehr auf den Konfigurationsordner
         auswich, waehrend ResolvePath weiter das Programmverzeichnis zuerst
         liest); die Textvorschau blieb nach dem Schliessen der
         Textregel-Bearbeitung stehen, obwohl sich die Regeln geaendert
         hatten; der Knopf "Speichern" fehlte in der Textansicht, dort
         entstehende Profilregeln wurden nur ueber die Rueckfrage beim
         Beenden gesichert. Nebenversion, weil neue Funktionen dazugekommen
         sind. -->
    <!-- 1.9.0: Einstellungen nach Themen statt nach Ablageort. Eine
         gemeinsame Regelliste ("Textregeln") zeigt Projekt- und
         Erweiterungsregeln nebeneinander, jede mit "Gilt für: dieses Projekt
         / alle Projekte" statt in zwei getrennten Reitern; eine gesperrte
         hauseigene Regel bekommt "Für dieses Projekt anpassen". Neue Regeln
         entstehen aus einem Beispielwert (PatternFromSample.TryRecognize
         erkennt eine vorhandene Regel dabei als "Alles dieser Form" oder
         "Genau dieser Wert" wieder, per Rundreise), dazu ein "?"-Knopf mit
         Spickzettel, KI-Hinweis samt Warnung vor Echtdaten und "Anfrage für
         die KI kopieren". Zweitens drei behobene Fehler aus der Messung fuer
         1.9.0 (siehe docs/testdokumentation.md): eine von Hand kommentierte
         Erweiterungsdatei wurde als Profil missverstanden und stillschweigend
         uebergangen, statt dass ihre Muster wirkten
         (ProfileStore.Classify/JsonFileKind, ExtensionLibrary.ResolvePath);
         das Regelformular war im globalen Reiter durch feste Hoehen
         abgeschnitten; Spaltenmuster liessen sich nicht mehr entfernen
         (fehlende Auswahl in der Liste). Drittens zwei kleinere Korrekturen:
         GetWriteState prueft jetzt zusaetzlich das Schreibrecht auf den
         Ordner der Erweiterungsdatei (fuer Zwischendatei und Sicherungskopie),
         und ein Schreibfehler in "Immer ersetzen" nimmt die eben angelegte
         Regel samt eigenem Generator zurueck, statt den Dialog abstuerzen zu
         lassen. -->
    <!-- 1.10.0: Gregors Wuensche aus dem Test von 1.9.0
         (docs/plan-regeln-generatoren.md). Erstens die Fundliste der Textansicht nennt zu jedem Fund
         die Herkunft ("fw . dieses Projekt" bzw. "alle Projekte") ueber die
         Regelreferenz (TextViewModel.DetermineScope), nicht ueber den Namen.
         Zweitens ein neuer Generator laesst sich jetzt von ueberall anlegen
         und bearbeiten: GeneratorEditorViewModel/-Window, ein einziges
         Ansichtsmodell fuer beides, erreichbar aus "Immer ersetzen…", dem
         Reiter "Eigene Generatoren" (der jetzt nur noch anzeigt, nicht mehr
         inline bearbeitet — Name und Optionen aendert der Dialog) und dem
         Regelformular. Neu dafuer in der Bibliothek GeneratorPreview
         (Beispielwert aus einem Wegwerf-Profil, ohne etwas zu speichern) und
         das Muster verschachtelter Dialoge (ShowGeneratorEditor auf
         AlwaysReplaceViewModel und SettingsViewModel, gesetzt vom
         DialogService mit dem jeweils eigenen Fenster als Besitzer).
         Drittens eine globale Regel nimmt einen bislang nur im Projekt
         vorhandenen Generator jetzt beim Uebernehmen automatisch mit
         (ExtensionLibrary.AdoptProjectGenerators) — vorher lief das nur beim
         Bereichswechsel selbst, nicht wenn eine schon globale Regel
         nachtraeglich einen Projekt-Generator waehlte. Viertens einheitliche
         Einstiege: das Fenster "Einstellungen" heisst jetzt "Regeln &
         Generatoren", "Regeln bearbeiten…" ersetzt den Knopf
         "Immer ersetzen…" der Dateiansicht (der kleine Dialog bleibt nur noch
         beim Markieren von Text erreichbar), und die Startseite bekommt
         denselben Einstieg, ohne Profil beschraenkt auf "alle Projekte"
         (MainViewModel.ShowSettingsAsync(globalOnly)). Fuenftens zeigt die
         Textansicht ihre Farben jetzt auch im Eingabefeld, nicht nur in der
         Prueffassung: HighlightTextBox legt beim Anwenden der Vorlage eine
         Zeichenebene unter PART_TextPresenter und zeichnet die Funde aus dem
         TextLayout des Presenters (TextViewModel.InputHighlights, nur gueltig,
         solange der Text dem des letzten Laufs entspricht). Sechstens drei
         Layoutfehler, beim Messen fuer 1.10.0 gefunden: die Kopfzeile
         ueberdeckte unter rund 880 Punkten den Programmnamen (unter 900 jetzt
         nur Zahnrad und Themensymbol), die Knoepfe der Karte "Felder"
         verdraengten deren Ueberschrift (jetzt eigene Zeile), und die
         Spalten der Fundliste fluchteten nicht (gemeinsame Spaltenbreiten).
         Dazu die Kennzeichnung als experimentell in beiden READMEs. -->
    <!-- 1.11.0: Der Generator-Dialog zeigte unter "Art der Ersetzung" alle 20
         eingebauten Generatoren, obwohl nur sieben davon ueberhaupt
         Einstellungen haben — die Liste wirkte, als liesse sich nur ein
         bestehender Generator kopieren. Sie zeigt jetzt unter der neuen
         Ueberschrift "Grundlage" nur noch die acht einstellbaren Arten
         (GeneratorKindOption.Configurable); die uebrigen (etwa "numericId")
         bleiben als eigener Namensraum weiterhin per JSON erreichbar und
         bekommen beim Bearbeiten einen angehaengten Listeneintrag samt
         Hinweis, damit nichts still auf "token" zurueckfaellt. Zweitens ein
         neuer Generator "expression": ein RegEx-aehnlicher Ausdruck, aber nur
         zum Erzeugen gedacht (GeneratorExpression, rekursiv absteigend
         geparst, TryParse statt Ausnahme), mit Zeichenklassen, Anzahl,
         Alternativen und Tabellenverweisen wie "{kreis}" — die Tabellen
         liegen im Generator selbst, er ist damit in sich vollstaendig und
         laesst sich samt Tabellen in ein anderes Projekt uebernehmen. Ein
         KFZ-Kennzeichen etwa: "{kreis}-[A-Z]{2} \d{2,3}E?". Im Dialog dafuer
         ein eigener Block mit immer sichtbarer Schreibweise-Tabelle, drei
         Vorlagen ueber "Beispiel einsetzen ▾" (KFZ-Kennzeichen, Kundennummer,
         Artikelnummer) und einer Tabellenverwaltung, die verwendete, aber
         nicht angelegte Tabellen anmahnt. Drittens zeigt die Vorschau des
         Dialogs jetzt bis zu drei Beispiele auf einmal
         (GeneratorPreview.TryExamples), fuer alle Arten, nicht nur fuer den
         Ausdruck-Generator. -->
    <!-- 1.12.0: Die Hoechstverschiebung der Datumsverschiebung ("maxDays",
         Basistyp dateShift) ist im Generator-Dialog einstellbar; dateShift
         steht damit als neunte Art unter "Grundlage". In OptionOwnership
         eingetragen, gilt als gesetzt aber nur, wenn der Wert weder 0 noch
         die Vorgabe 400 ist — gespeicherte Profile tragen "maxDays": 400 an
         jedem Generator und duerfen dadurch nicht ploetzlich Fehler zeigen.
         Neu geprueft: hoechstens 36500 Tage (GeneratorSettings.MaxDaysLimit),
         sonst fuehrte DateTime.AddDays ueber den Kalender hinaus. Beim
         Bearbeiten warnt der Dialog, sobald der Wert abweicht: die
         Verschiebung wird aus ihm abgeleitet, und ohne Ersetzungstabelle
         liessen sich aeltere Pseudodaten nicht mehr zurueckrechnen. Dazu
         nimmt die Vorschau fuer die drei Datumsarten ein Datum als
         vorgegebenes Beispiel statt "Beispiel 4711". -->
    <!-- 1.13.0: Ein Generator-Eintrag ohne "type", dessen Schluessel ein
         eingebauter Generatorname ist (etwa "email": { "domain": "firma.test" }),
         erschien im Reiter "Eigene Generatoren" faelschlich als "token"
         (GeneratorEntryViewModel.TypeLabel fiel bei leerem Type darauf
         zurueck statt auf den Schluessel), und "Bearbeiten..." sperrte
         "Uebernehmen" mit dem Namensfehler "eingebauter Generator". Beides
         behoben: TypeLabel und der Generator-Dialog behandeln eine solche
         Umstellung jetzt als das, was sie ist — Name und Grundlage stehen
         fest, "Entfernen" setzt nur die eingebaute Vorgabe zurueck und bleibt
         darum auch bei Verwendung durch eine Regel moeglich. Zweitens
         speichert die Oberflaeche jetzt nur noch gesetzte Werte:
         OmitFromJsonWhenAttribute samt Modifier in ProfileStore.JsonOptions
         blendet "maxDays": 400, "keepFirst"/"keepLast": 0, "captureGroup": 0
         und "ignoreCase": false aus, sobald sie ihrer Vorgabe entsprechen —
         auch eine aeltere Datei raeumt sich damit beim naechsten Speichern
         von selbst auf. Drittens drei bislang nur per Texteditor erreichbare
         Optionen jetzt im Generator-Dialog: "formats" (eigene Datumsformate,
         fuer dateShift, dateRange und dateGeneralize), "country" (Land fuer
         iban/bic) und "domain" (fuer email, mit Warnung bei einer
         moeglicherweise echt erreichbaren Adresse); dazu "captureGroup" im
         Textregel-Formular ("Ersetzte Gruppe"), mit einer Warnung, wenn das
         Muster die gewaehlte Gruppe gar nicht hat. ProfileValidator.OptionOwnership
         erlaubt dafuer erstmals mehrere Basistypen je Option, mit den neuen
         Helfern OptionBelongsTo und OwnersOf. -->
    <Version>1.13.0</Version>

    <!-- Lokal ist keine 8.0-Runtime installiert. Mit Major-Roll-Forward laufen
         "dotnet run" und "dotnet test" auf der vorhandenen 10.0-Runtime,
         waehrend das Zielframework net8.0 bleibt. -->
    <RollForward>Major</RollForward>
  </PropertyGroup>
</Project>
