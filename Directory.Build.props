<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- Eine Fassung fuer alle Projekte. Vorher stand sie nur in der
         Oberflaeche, das Kommandozeilenprogramm lief auf der Vorgabe 1.0.0
         mit — zwei Programme desselben Pakets duerfen nicht auseinanderlaufen.
         1.0.1: Behebung der Befunde D-4 und D-8 der Testdurchfuehrung vom
         4. September 2026, siehe docs/testdokumentation.md.
         1.0.2: Fassung und Ersteller stehen jetzt unter jeder Hilfeausgabe
         des Kommandozeilenprogramms.
         1.1.0: Profilverwaltung: fester Ablageort, Anlegen-Dialog mit Namen
         und Beschreibung, Profiluebersicht, Umbenennen ohne Verlust der
         Ersetzungstabelle, Rueckfrage bei ungespeicherten Aenderungen; auf der
         Kommandozeile 'obfuskation profile list' und die Option config, jetzt
         auch mit blossem Profilnamen statt Dateipfad. Dazu eine Kurzhilfe im
         Menue "Mehr" und neue Beschriftungen der beiden Schaltflaechen unten:
         "Pseudodatei erzeugen..." und "Klartextdatei erzeugen...". Nebenversion
         statt Korrekturstand, weil Funktionen dazugekommen sind.
         1.2.0: Mehrfachauswahl in der Feldliste — Aktion und Generator gelten
         fuer alle gewaehlten Felder auf einmal. Dazu behoben: als Einzeldatei
         veroeffentlicht brach die Oberflaeche bei jedem Schreiben einer
         Konfiguration stumm ab, weil die mitgepackte System.IO.Pipelines 8.0.0
         die der Laufzeit verdeckte; siehe Kommentar in
         src/Obfuskation.Gui/Obfuskation.Gui.csproj.
         1.3.0: Schnellwahl "Zuletzt ▾" zwischen den Dateien eines Profils ohne
         Oeffnen-Dialog; Feldvorschau steht jetzt ueber der Aktionswahl, zeigt
         bis zu drei Beispielwerte und erscheint auch ohne moegliche Vorschau,
         mit CsvHelper statt Eigenbau und richtigem Zeichensatz (auch JSON);
         konfigurierbares Praefix je Token-Namensraum
         (GeneratorSettings.Prefix), von 'init' vorgeschlagen und ueber die
         Regelkarte setzbar. Dazu behoben: N-1 (Untertitel abgeschnitten),
         D-5 (Bildlaufleiste ueber den Anzahlen), D-6 (Hinweistext
         abgeschnitten), D-1 (doppelte Befundliste), D-3 (Hinweise bei
         fehlerhafter Konfiguration jetzt sichtbar) und D-9 (Speichern in der
         Einzeldatei-Veroeffentlichung); D-2 bekommt zusaetzlich eine Warnung
         im Bericht ("datumMitFremdemProfil"); D-7 teilweise behoben: Text der
         Hilfeoption jetzt deutsch, die Ueberschrift "Description:" bleibt aus
         den in Abschnitt 11 der Entwicklerdokumentation genannten Gruenden
         eine bekannte Einschraenkung des Pakets System.CommandLine 2.0.11.
         1.4.0: Profiluebersicht: "Aus Liste entfernen" blendet den Eintrag
         jetzt dauerhaft aus (GuiSettings.HiddenProfiles), statt dass er beim
         naechsten Aufbau der Liste ohne Nutzungsdaten zurueckkommt, weil
         ProfileCatalog.Collect den zentralen Profilordner ohnehin immer
         vollstaendig auflistet. Dazu neu "Profil
         loeschen..." mit Rueckfrage, ob die Ersetzungstabelle mitgeloescht
         wird. "Neu aus Datei..." erlaubt jetzt Mehrfachauswahl: ein Profil
         entsteht aus den Feldern aller gewaehlten Dateien auf einmal
         (ProfileScaffolder.Create mit mehreren Pfaden). Neu die Sammellaeufe
         "Alle Pseudodateien erzeugen..." und "Alle Klartextdateien
         erzeugen...", mit genau einer Rueckfrage statt einer je Datei;
         geschrieben wird jeweils neben die Eingabedatei.
         1.5.0: Fuenf neue Generatoren. Fuer Datumswerte war 'dateShift'
         bisher der einzige Weg; sein profilweit konstanter Offset erhaelt
         Reihenfolge und Abstaende und ist genau deshalb angreifbar, sobald
         ein einziges Datum des Bestands bekannt ist. Neu daneben
         'dateRange' (zieht ein Datum, umkehrbar ueber die Ersetzungstabelle;
         ohne 'from'/'to' bleibt das Kalenderjahr des Originals) und
         'dateGeneralize' (rundet auf Monat, Quartal oder Jahr, ausdruecklich
         nicht umkehrbar). 'dateShift' bleibt die Vorgabe als einziger
         Generator, der Reihenfolge und Abstaende erhaelt. Ausserdem
         'pattern' (Wert nach Maske, ohne Maske formaterhaltend aus dem
         Original abgeleitet), 'wordlist' (eigene Werteliste im Profil)
         und 'partialMask' (haelt einen Teil des Wertes sichtbar): drei
         Faelle, die bisher alle beim generischen 'token' landeten.
         Dazu 'defaults.emptyValues', damit faktisch leere Werte ("-",
         "N/A", reiner Leerraum) nicht laenger ein Pseudonym bekommen;
         'redact' liest seinen Platzhalter aus einem eigenen Feld statt aus
         'domain', womit ein eigener Namensraum seinen Platzhalter behalten
         kann; die MappingConflictException nennt die zum Generator passende
         Abhilfe statt pauschal 'token'; 'deobfuscate' meldet Werte nicht
         umkehrbarer Generatoren als "nichtWiederherstellbar" statt als
         unbekanntes Pseudonym. In der Oberflaeche ein eigener Dialog fuer
         die neuen Optionen, der seine Zuordnung aus
         ProfileValidator.OptionOwnership liest.
         1.6.0: Erweiterungsdatei. Hauseigene Muster, etwa eine Inventarnummer der
         Form INV123456, sind Betriebswissen und haben in einer Profildatei
         nichts verloren, die geteilt oder eingecheckt wird. Sie liegen
         deshalb in einer eigenen, privaten Datei namens obfuskation.json,
         gesucht zuerst neben der Programmdatei, sonst unter
         ~/.config/obfuskation (Klasse ExtensionLibrary, vormals
         GeneratorLibrary), und fliessen zur Laufzeit in jedes Profil ein,
         ohne je hineingeschrieben zu werden; bei gleichem Namen gewinnt
         immer das Profil. Neu dazu der Befehl 'extensions list' bzw. 'path'
         (vormals 'library') und die Option 'no extensions' (vormals
         'no library'), die einen Lauf ohne die Erweiterungsdatei erzwingt.
         Zweitens die wertbasierte Mustererkennung (ValueSuggester): zaehlt
         zuerst, ob die Beispielwerte vollstaendig auf ein bekanntes Muster
         passen, eingebautes oder eigenes aus der Erweiterungsdatei. In der
         Oberflaeche als Knopf "Muster erkennen...", auf der Kommandozeile in
         den Kommentaren von 'init'. Drittens neu der Abschnitt fieldRules in
         der Erweiterungsdatei (Klasse FieldNameSuggester): Regeln auf den
         ganzen Spaltennamen, erste passende Regel gewinnt, Sonderwert
         scanText fuer Freitextfelder. Das bis einschliesslich 1.5.0 fest
         einkompilierte Raten an dreissig Namensfragmenten
         (ProfileScaffolder.Hints) ist dabei ersatzlos entfallen: ohne
         Erweiterungsdatei raet das Programm nicht mehr am Spaltennamen.
         Ersatz ist docs/beispiel/obfuskation-erweiterung-beispiel.json, das
         die alte Liste als fieldRules enthaelt. Vorschlagsreihenfolge damit:
         Wertetreffer, dann Spaltennamenregel aus der Erweiterungsdatei,
         sonst eigener token-Namensraum. Viertens die Profildatei umbenannt
         auf obfuskation-projekt.json (ProfileStore.DefaultFileName); eine
         vorhandene obfuskation.json mit Profilinhalt bleibt lesbar
         (LegacyFileName, LooksLikeProfile unterscheidet die beiden Rollen
         am Inhalt). Fuenftens der Nachzug der Dokumentation: die fuenf
         Generatoren aus 1.5.0 standen in keiner Doku, und die
         Entwicklerdokumentation behauptete noch, 'redact' zweckentfremde
         'domain' als Platzhalter.
         1.7.0: Drei Zugaenge statt einem leeren Startfenster. Neu die
         Startseite (drei Karten: Text saeubern, Dateien pseudonymisieren,
         Antwort zurueckholen) und die Textansicht; Zwischenablage
         einfuegen, Fundstellen mit Haekchen einzeln abwaehlbar, "Kopieren"
         legt erst dann Eintraege in der Ersetzungstabelle an. Ohne
         geladenes Profil legt die Textansicht ein Vorgabeprofil 'text' an;
         MappingStore.EnsureCreated (neu, ObfuscationEngine.EnsureMappingStore
         als duenne Huelle darum) sorgt dafuer, dass ein Probelauf exakt
         dieselben Werte liefert wie der echte. Zweitens "Immer ersetzen…":
         aus einem markierten Begriff (Textansicht) oder einem Feld-
         Beispielwert (Dateiansicht, Knopf neben "Felder automatisch
         erkennen…", vormals "Muster erkennen…") in drei Fragen ohne
         regulaeren Ausdruck eine Regel ableiten; PatternFromSample (neu)
         bildet aus 'FW123456' wahlweise "genau dieses Wort" oder "FW + 6
         Ziffern"; gilt sie "immer, in allen Projekten", landet sie ueber
         ExtensionLibrary.Save (neu, mit Sicherungskopie bei einer von Hand
         kommentierten Datei) in der Erweiterungsdatei statt im Profil. Der
         Menueintrag "Textregeln…" entfaellt, die Fachansicht bleibt aus
         diesem Dialog ueber "Muster von Hand bearbeiten…" erreichbar; neu
         dafuer "Hauseigene Muster…", das Fundort und geerbte Regeln der
         Erweiterungsdatei zeigt, bisher nur ueber 'obfuskation extensions
         path' zu erfahren. Drittens zwei kleine Korrekturen: eine geoeffnete
         Fliesstextdatei zeigte in der Feldliste faelschlich "Keine Datei
         geöffnet" statt eines Hinweises auf "Immer ersetzen…" samt Knopf "In
         der Textansicht öffnen"; die Kurzhilfe nennt jetzt auch den
         Textmodus.
         1.7.1: Die Startseite aus 1.7.0 bekam kaum jemand zu sehen. Sie
         erschien nur, wenn weder ein Profil uebergeben noch eines gefunden
         noch eines zuletzt benutzt worden war — wer schon einmal mit einem
         Profil gearbeitet hat, hat aber ab dann immer einen Eintrag in
         GuiSettings.RecentProfiles und landete darum wie vor 1.7.0 sofort in
         der Dateiansicht. Betroffen war damit genau jeder Bestandsanwender,
         also jeder, dem Textansicht und "Immer ersetzen…" neu sind. Die
         Startseite ist jetzt der Einstieg; uebersprungen wird sie allein bei
         einem Profil oder einer Datei auf der Befehlszeile, wo jemand
         ausdruecklich gesagt hat, was er will. Ein zuletzt benutztes Profil
         wird weiterhin geladen und steht dort als erste Karte "Weiter mit …"
         bereit, die nur die Ansicht wechselt (kein zweites Laden, eine
         geoeffnete Datei bleibt offen). Dazu ein sichtbarer Rueckweg
         "← Start" in der Kopfzeile: der anklickbare Programmname tat das
         schon, wurde aber als Ueberschrift gelesen, nicht als
         Schaltflaeche. -->
    <Version>1.7.1</Version>

    <!-- Lokal ist keine 8.0-Runtime installiert. Mit Major-Roll-Forward laufen
         "dotnet run" und "dotnet test" auf der vorhandenen 10.0-Runtime,
         waehrend das Zielframework net8.0 bleibt. -->
    <RollForward>Major</RollForward>
  </PropertyGroup>
</Project>
